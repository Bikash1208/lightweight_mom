    def test_sidelobe_endpoint_end_to_end(tmp_path, monkeypatch):
        """`/api/sidelobes/optimize` on a finished hex4 job: a new job result with the optimised board,
        before/after tables on the held-out grid, and an exportable layout."""
        import time

        from fastapi.testclient import TestClient

        from src.app.main import create_app

        monkeypatch.setenv("LWMOM_APP_DATA_DIR", str(tmp_path / "data"))
        import types

        import src.hologram.auto_states as auto_mod

        def fake_auto_states(n_bits, substrate, f, period_m, fixed_L_mm=None, cache_dir=None, **_):
            shift = (f - F) / 1e9 * 60.0  # no MoM in the fast suite: a linear stand-in for the re-solved cells
            return types.SimpleNamespace(
                states=[
                    types.SimpleNamespace(gamma=np.exp(1j * np.radians(138.0))),
                    types.SimpleNamespace(gamma=np.exp(1j * np.radians(-41.0 - shift))),
                ]
            )

        monkeypatch.setattr(auto_mod, "auto_states", fake_auto_states)
        client = TestClient(create_app())

        def wait(job_id, timeout=300):
            t0 = time.monotonic()
            while True:
                job = client.get(f"/api/jobs/{job_id}").json()
                if job["status"] in ("done", "failed", "cancelled"):
                    return job
                assert time.monotonic() - t0 < timeout
                time.sleep(0.1)

        body = _request({"preset": "hex4", "side_mm": 50.0, "gap_mm": 0.0})
        synth = wait(client.post("/api/hmsa/synthesize_ports", json=body).json()["id"])
        assert synth["status"] == "done", synth
        req = {
            "source_job_id": synth["id"],
            "frequency_hz": F,
            "period_mm": 6.4,
            "eps_r": 2.2,
            "tan_delta": 0.0009,
