# --- Python / venv -----------------------------------------------------------
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.coverage
htmlcov/

# --- OS / IDE ------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# --- Large, regenerable generated data ------------------------------------------
# The Phase 7 unit-cell-library checkpoint and its derived database/geometry exports
# (~554 MB total): fully regenerable via `examples/build_unit_cell_library.py`
# (resumable, appends to checkpoint.jsonl). Tests needing them skip cleanly when
# absent (tests/conftest.py's session fixture). manifest.json/reports/plots are kept
# (small, useful as committed reference).
results/unit_cell_library/_solve/
results/unit_cell_library/database/
results/unit_cell_library/geometry/

# Real HFSS Touchstone exports (~23 MB each; 3 of them ~70 MB total). Regenerable
# only by re-running HFSS itself -- NOT regenerable from this repo's own code.
# hfss_data-marked tests skip cleanly when these are absent
# (see docs/DEVELOPING.md "Regenerating or fetching excluded data").
*.s36p
*.s4p

# An ad hoc snapshot of src/ bundled alongside an HFSS delivery at some point;
# redundant with the tracked src/ tree itself.
hfss_exports/_src_snapshot.tgz

# New HFSS export packages' own STEP files: large, binary, regenerable from layout.json via the
# app's Export page (hfss_exports/README.md). Only affects NEW packages -- the STEP files already
# tracked before this rule was added (phase12_grounded_8mm/, two_beam_20deg_phi0_180/) stay tracked;
# gitignore never untracks a file that is already in the index.
hfss_exports/**/*.step
# Export-package growth policy (Phase 24 item 5): a NEW package commits its README, design report JSON, PNGs
# and small CSV; the vector layouts (layout.dxf / layout.json) run 1-4 MB on a 300 mm board and are
# regenerable from the package's own request, so they stay out of git. A layout under 1 MB may still be
# committed on purpose with `git add -f`. Files already tracked stay tracked (gitignore never untracks).
hfss_exports/**/layout.dxf
hfss_exports/**/layout.json
# Phase 19 lens printing mesh: ~1.3 MB, regenerable (examples/export_nylon_lens_28ghz.py)
hfss_exports/nylon_lens_28ghz_dual30/*.stl

# Cached per-frequency MoM current coefficients for the square-loop FSS finite-panel check
# (scripts/adhoc/fss/plane_s.py's input) -- kept on disk, not in git; regenerate with
# scripts/adhoc/fss/mom_save.py (see scripts/adhoc/README.md).
scripts/adhoc/fss/coef/

# Reference-paper PDFs (copyrighted third-party journal articles, supplied locally
# by the user for methodology reference) -- never committed, cited by DOI instead.
docs/references/*.pdf

# --- Stray files not meant to be tracked ---------------------------------------
/efl.txt
results/phase20_r4/chunks/
